<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Memory watchdog for the Oxigraph daemon. Runs every 30 seconds and kills
  Oxigraph if its RSS exceeds the ceiling; KeepAlive on the main daemon then
  restarts it clean.

  Install:
    sudo cp org.catalogueoflife.oxigraph-watchdog.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/org.catalogueoflife.oxigraph-watchdog.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/org.catalogueoflife.oxigraph-watchdog.plist

  Check it is alive:
    tail -f /Users/rpage/oxigraph-watchdog.log

  Fires on sustained CPU rather than memory — see the script header for the
  measurements that led to that. Reinstall after editing:

    sudo launchctl bootout system/org.catalogueoflife.oxigraph-watchdog
    sudo cp org.catalogueoflife.oxigraph-watchdog.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/org.catalogueoflife.oxigraph-watchdog.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/org.catalogueoflife.oxigraph-watchdog.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.catalogueoflife.oxigraph-watchdog</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/rpage/Sites/iphylo/col/deploy/macos/oxigraph-watchdog.sh</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- Busy threshold, and how many consecutive 30s checks at that level
		     before killing. 3 x 30s = ~90s of continuous burn. A legitimate
		     full scan takes ~23s, so it shows up in one sample at most. -->
		<key>CPU_PCT</key>
		<string>50</string>
		<key>STRIKES</key>
		<string>3</string>
		<!-- Backstop only. RSS is a poor primary signal here: it counts mmap'd
		     RocksDB pages the kernel reclaims on its own. -->
		<key>RSS_CEILING_MB</key>
		<string>6144</string>
	</dict>

	<key>UserName</key>
	<string>rpage</string>

	<key>StartInterval</key>
	<integer>30</integer>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardErrorPath</key>
	<string>/Users/rpage/oxigraph-watchdog.err.log</string>
</dict>
</plist>
