<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install as a LaunchDaemon so the Mini serves after a reboot without anyone
  logging in:

    sudo cp org.catalogueoflife.oxigraph.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/org.catalogueoflife.oxigraph.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/org.catalogueoflife.oxigraph.plist

  Restart after a data swap:

    sudo launchctl kickstart -k system/org.catalogueoflife.oxigraph

  Stop it:

    sudo launchctl bootout system/org.catalogueoflife.oxigraph

  Adjust UserName for the Mini's account. You do NOT need to stop the service
  to load data — load-mini.sh builds into the idle slot while this one keeps
  serving.

  The store lives at ~/oxigraph-col, deliberately outside ~/Sites/iphylo: the
  git checkout is the web root, so anything inside it is one Apache
  misconfiguration away from being downloadable.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.catalogueoflife.oxigraph</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/oxigraph</string>
		<string>serve-read-only</string>
		<!-- A symlink to store-a or store-b, swapped by load-mini.sh so the
		     endpoint stays up during a reload. Oxigraph resolves it at open
		     time, so a swap takes effect on restart.

		     Deliberately OUTSIDE ~/Sites/iphylo: the checkout is the web root,
		     and keeping the store out of it is safer than trusting a deny
		     rule to hide a 24 GB RocksDB directory. -->
		<string>--location</string>
		<string>/Users/rpage/oxigraph-col/current</string>
		<!-- Loopback only. Apache is the sole route in from outside. -->
		<string>--bind</string>
		<string>127.0.0.1:7878</string>
		<!-- Federated callers cannot know your graph names; without this a
		     named-graph load returns zero rows instead of erroring. -->
		<string>--union-default-graph</string>
	</array>

	<key>UserName</key>
	<string>rpage</string>

	<key>WorkingDirectory</key>
	<string>/Users/rpage/oxigraph-col</string>

	<!-- Lose CPU contention to Apache. If a heavy query pins the cores, the
	     other sites on this host stay responsive. Costs the SPARQL endpoint
	     some speed under load, which is the right trade here. -->
	<key>Nice</key>
	<integer>5</integer>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<!-- RocksDB keeps many .sst files open; the store has ~550 of them. -->
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/rpage/Library/Logs/oxigraph.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/rpage/Library/Logs/oxigraph.err.log</string>
</dict>
</plist>
